#! /usr/bin/env python3

# argparse
import argparse
# os
import os
# subprocess
import subprocess
# sys
import sys

# acropolis
import acropolis
# pprint
from acropolis.pprint import print_info, print_error, print_version, print_Yf
# models
from acropolis.models import DecayModel, AnnihilationModel


def parse_args():
    parser = argparse.ArgumentParser(prog="acropolis")
    
    subparsers = parser.add_subparsers(
        dest="command", required=True, help="Available commands"
    )
    
    # download-db
    subparsers.add_parser(
        "download-db", help="Download additional database files"
    )
    
    # compile
    subparsers.add_parser(
        "pre-compile", help="Compile some performance-critical functions"
    )

    # run-decay
    decay_parser = subparsers.add_parser(
        "run-decay", help="Run the pre-implemented DecayModel"
    )
    # -->
    decay_parser.add_argument(
        "mphi", type=float, help="The mass of the decaying particle [in MeV]"
    )
    decay_parser.add_argument(
        "tau", type=float, help="The lifetime of the decaying particle [in s]"
    )
    decay_parser.add_argument(
        "temp0", type=float, help="Some reference temperature T0 [in MeV]"
    )
    decay_parser.add_argument(
        "n0a", type=float, help="The number density of the decaying particle (relative to photons) at T0"
    )
    decay_parser.add_argument(
        "bree", type=float, help="The branching ratio into electron-positron pairs"
    )
    decay_parser.add_argument(
        "braa", type=float, help="The branching ratio into two photons"
    )

    # run-annih
    annih_parser = subparsers.add_parser(
        "run-annih", help="Run the pre-implemented AnnihilationModel"
    )
    # -->
    annih_parser.add_argument(
        "mchi", type=float, help="The mass of the dark-matter particle [in MeV]"
    )
    annih_parser.add_argument(
        "a", type=float, help="The s-wave constribution to the cross-section [in cm^3/s]"
    )
    annih_parser.add_argument(
        "b", type=float, help="The p-wave constribution to the cross-section [in cm^3/s]"
    )
    annih_parser.add_argument(
        "tempkd", type=float, help="The kinetic decoupling temperature of the dark-matter particle [in MeV]"
    )
    annih_parser.add_argument(
        "bree", type=float, help="The branching ratio into electron-positron pairs"
    )
    annih_parser.add_argument(
        "braa", type=float, help="The branching ratio into two photons"
    )
    annih_parser.add_argument(
        "omegah2", type=float, nargs="?", default=0.12, help="The density parameter of dark-matter (optional, default: 0.12)"
    )

    return parser.parse_args()


def download_db():
    print_info(
        "Since v1.1 this operation is no longer needed."
    )


def compile_module(module):
    package_dir = os.path.dirname( acropolis.__file__ )

    print_info(f"Compiling acropolis.aot.{module}")
    result = subprocess.run(
        [sys.executable, f"{package_dir}/aot/{module}.py"], text=True, capture_output=True
    )

    if result.returncode != 0:
        print_error(f"Compilation failed:\n{result.stderr}")


def run_decay(mphi, tau, temp0, n0a, bree, braa):
    Yf = DecayModel(
        mphi, tau, temp0, n0a, bree, braa
    ).run_disintegration()

    print_Yf(Yf)


def run_annih(mchi, a, b, tempkd, bree, braa, omegah2):
    Yf = AnnihilationModel(
        mchi, a, b, tempkd, bree, braa, omegah2
    ).run_disintegration()

    print_Yf(Yf)


def main():
    print_version()

    args = parse_args()

    if args.command == "download-db":
        download_db()
    
    elif args.command == "pre-compile":
        compile_module("pycc_cascade")
    
    elif args.command == "run-decay":
        run_decay(
            args.mphi, args.tau, args.temp0, args.n0a, args.bree, args.braa
        )
    
    elif args.command == "run-annih":
        run_annih(
            args.mchi, args.a, args.b, args.tempkd, args.bree, args.braa, args.omegah2
        )


if __name__ == "__main__":
    main()