#! /usr/bin/env python3

# argparse
import argparse
# os
import os
# subprocess
import subprocess
# sys
import sys

# acropolis
import acropolis
# pprint
from acropolis.pprint import print_info, print_error, print_version


def download_db():
    print_info(
        "Since v1.1 this operation is no longer needed."
    )


def compile_module(module):
    package_dir = os.path.dirname( acropolis.__file__ )

    print_info(f"Compiling acropolis.aot.{module}")
    result = subprocess.run(
        [sys.executable, f"{package_dir}/aot/{module}.py"], text=True, capture_output=True
    )

    if result.returncode != 0:
        print_error(f"Compilation failed:\n{result.stderr}")


def run_decay():
    pass

def run_annihilation():
    pass


def main():
    parser = argparse.ArgumentParser(prog="acropolis")
    # -->
    subparsers = parser.add_subparsers(dest="command", required=True, help="Available commands")
    
    # download-db
    subparsers.add_parser("download-db", help="Download additional database files")
    
    # compile
    subparsers.add_parser("compile", help="Compile performance-critical functions")

    # -->
    args = parser.parse_args()

    print_version()

    if args.command == "download-db":
        download_db()
    elif args.command == "compile":
        compile_module("pycc_cascade")


if __name__ == "__main__":
    main()